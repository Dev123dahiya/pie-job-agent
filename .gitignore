# Personal resumes and everything the app writes: logs, backups, screenshots, exports,
# the SQLite database and the browser profile (data/browser/, holds your site logins).
# Ignored as whole folders; the code creates the subfolders it needs.
/resumes/
/data/
*.dump
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

