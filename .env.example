# Copy to .env and fill in. .env is git-ignored - never commit real values.

# --- Safety ---------------------------------------------------------------
# true  -> never submit real applications; use mock jobs/forms/emails; log intended actions.
# Only set to false after the end-to-end mock workflow passes (Phase 10).
DEVELOPMENT_MODE=true

ENVIRONMENT=local
LOG_LEVEL=INFO
# Your timezone; defines "today" on the dashboard.
TIMEZONE=Asia/Kolkata

# --- Database -------------------------------------------------------------
# Matches docker-compose.yml. Driver: psycopg (v3).
DATABASE_URL=postgresql+psycopg://pie:pie@localhost:5432/pie_job_agent
POSTGRES_USER=pie
POSTGRES_PASSWORD=pie
POSTGRES_DB=pie_job_agent

# --- API ------------------------------------------------------------------
# JSON list of origins allowed to call the API.
CORS_ORIGINS=["http://localhost:3000"]

# --- Claude job analysis -----------------------------------------------------
# auto       : Anthropic API if ANTHROPIC_API_KEY is set, else the local Claude Code CLI
#              (`claude`, signed in with your Claude subscription)
# claude_api : Anthropic API only          claude_cli : Claude Code CLI only
# heuristic  : keyword matcher for offline testing - NOT Claude, and labelled as such
ANALYZER_BACKEND=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium
# Model for the CLI backend; empty = the CLI's default model.
CLAUDE_CLI_MODEL=
CLAUDE_TIMEOUT_SECONDS=240

# --- Master resume (read-only) -----------------------------------------------
# Where the agent reads your master resume (PDF/Markdown/text). It is never modified.
# Unset: the first file in resumes/master/ is used.
# MASTER_RESUME_PATH=C:/path/to/Resume.pdf

# --- Job discovery ----------------------------------------------------------
# JOB_SOURCES_PATH=config/job_sources.yaml
# SHORTLIST_RULES_PATH=config/shortlist_rules.yaml

# --- Browser execution (Phase 5) ---------------------------------------------
# LIVE external submission. Keep false: dry runs never submit. It only takes effect with
# DEVELOPMENT_MODE=false (DEVELOPMENT_MODE=true always blocks live: DEVELOPMENT_MODE_BLOCKED),
# needs BROWSER_HEADLESS=false, and every application still needs your explicit confirmation.
EXTERNAL_LIVE_ENABLED=false
# auto = Playwright's bundled Chromium, else installed Microsoft Edge, else Google Chrome.
BROWSER_CHANNEL=auto
# Set to false for any session that may need you (CAPTCHA, OTP, 2FA, login) - required for live.
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
# Optional: a browser profile directory where YOU are already signed in to a job portal.
# PIE never reads its cookies and never stores passwords. Unset = always signed out.
# BROWSER_USER_DATA_DIR=C:/path/to/browser-profile
# Screenshots and execution artifacts (git-ignored).
# APPLICATION_ARTIFACTS_DIR=data/applications

# --- Daily discovery + analysis (Phase 5.5) -----------------------------------
# Runs inside the API process (uvicorn backend.main:app) once a day at DAILY_RUN_TIME
# (24h, in TIMEZONE); if the machine was off then, it runs on the next start that day.
# Discovery and analysis only - never applications. Manual run: python -m backend.scripts.daily run
DAILY_RUN_ENABLED=true
DAILY_RUN_TIME=07:00
# Most fresh jobs one daily run sends to Claude.
DAILY_RUN_ANALYSIS_LIMIT=50

# --- Adzuna Jobs API (optional job source) -----------------------------------
# Your own free key from https://developer.adzuna.com/ ; then set enabled: true for the
# adzuna source in config/job_sources.yaml. Never commit these.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Gmail (Phase 6) -------------------------------------------------------
# OAuth client JSON downloaded from Google Cloud Console, and where to store the token.
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=

# --- Profile ---------------------------------------------------------------
# Defaults to config/user_profile.yaml (falls back to the .example file).
# USER_PROFILE_PATH=config/user_profile.yaml
